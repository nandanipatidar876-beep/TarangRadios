# -----------------------------------------------------------------------------
# TARANG RADIOS CONFIGURATION
# -----------------------------------------------------------------------------

# Server Port
PORT=8000

# Secure Admin Initial Credentials
ADMIN_USERNAME=tarang_admin
ADMIN_PASSWORD=change_this_to_a_secure_password_123!

# PostgreSQL Connection URL
# Example Supabase / Neon: postgresql://postgres.xxxx:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Example Local: postgresql://postgres:postgres@localhost:5432/tarang_db
DATABASE_URL=

# Cloudinary Storage & CDN Credentials (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# (Optional) Direct Cloudinary URL shortcut:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Secret Price Access Code (Protected pricing: visitors enter this code to unlock and view prices)
PRICE_ACCESS_CODE=1972
